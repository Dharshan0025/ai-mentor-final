# Project-level gitignore
node_modules/
dist/
build/
.env
*.env.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

# Frontend build
frontend/dist/

# Secrets — NEVER commit these
agents/.env
backend/.env
frontend/.env
*.pem
*.key
