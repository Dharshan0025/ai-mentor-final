# ============================================
# AI-Mentor Agent Service — Environment Config
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================

# --- LLM API Keys ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- LLM Model Names ---
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# --- Bedrock (AI Tutor only — higher rate limits) ---
# Option A: Bedrock API key (from console: Generate short/long-term API keys)
BEDROCK_API_KEY=bedrock-api-key-<paste your key here>
# Option B: IAM credentials (if not using API key)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Database ---
# For Supabase, use the connection pooler URL (IPv4 compatible)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.zsmyyzasczbgdlsnhkiz:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
PGVECTOR_ENABLED=true

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Service ---
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
NODE_API_ORIGIN=http://localhost:3001

# --- Privacy ---
# When true, student PII is anonymized before sending to external LLMs
ANONYMIZE_PII=true

# --- App ---
ENV=development
LOG_LEVEL=INFO
